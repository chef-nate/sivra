#include "embedded_examples.hpp"

#include <array>
#include <stdexcept>

namespace {

constexpr std::string_view dot_product_json = R"sivra_json(@SIVRA_DOT_PRODUCT_JSON@)sivra_json";
constexpr std::string_view weighted_clamp_json =
  R"sivra_json(@SIVRA_WEIGHTED_CLAMP_JSON@)sivra_json";
constexpr std::string_view mat4_transform_xmm0_json =
  R"sivra_json(@SIVRA_MAT4_TRANSFORM_XMM0_JSON@)sivra_json";
constexpr std::string_view mat4_transform_xmm1_json =
  R"sivra_json(@SIVRA_MAT4_TRANSFORM_XMM1_JSON@)sivra_json";
constexpr std::string_view mat4_transform_xmm2_json =
  R"sivra_json(@SIVRA_MAT4_TRANSFORM_XMM2_JSON@)sivra_json";

constexpr std::array names{
  std::string_view("dot-product"),
  std::string_view("weighted-clamp"),
  std::string_view("mat4-transform"),
};

constexpr std::array dot_product{
  sivra::tool::embedded_expression{
    .output = "xmm0",
    .json = dot_product_json,
  },
};

constexpr std::array weighted_clamp{
  sivra::tool::embedded_expression{
    .output = "xmm0",
    .json = weighted_clamp_json,
  },
};

constexpr std::array mat4_transform{
  sivra::tool::embedded_expression{
    .output = "xmm0",
    .json = mat4_transform_xmm0_json,
  },
  sivra::tool::embedded_expression{
    .output = "xmm1",
    .json = mat4_transform_xmm1_json,
  },
  sivra::tool::embedded_expression{
    .output = "xmm2",
    .json = mat4_transform_xmm2_json,
  },
};

} // namespace

namespace sivra::tool {

std::span<const std::string_view> example_names() {
  return names;
}

std::span<const embedded_expression> example_expressions(
  std::string_view example
) {
  if (example == "dot-product") {
    return dot_product;
  }
  if (example == "weighted-clamp") {
    return weighted_clamp;
  }
  if (example == "mat4-transform") {
    return mat4_transform;
  }

  throw std::invalid_argument("unknown embedded example");
}

} // namespace sivra::tool
